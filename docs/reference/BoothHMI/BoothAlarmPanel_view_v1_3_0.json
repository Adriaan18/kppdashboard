{
  "custom": {
    "count": -1,
    "version": "1.3.0"
  },
  "params": {
    "filter": "SDB,HOG",
    "title": "DEBARKER"
  },
  "propConfig": {
    "custom.count": {
      "binding": {
        "config": {
          "expression": "coalesce(runScript(\u0027booth.ui.alarmCount\u0027, 5000, {view.params.filter}), -1)"
        },
        "type": "expr"
      },
      "persistent": true
    },
    "custom.version": {
      "persistent": true
    },
    "params.filter": {
      "paramDirection": "input",
      "persistent": true
    },
    "params.title": {
      "paramDirection": "input",
      "persistent": true
    }
  },
  "props": {
    "defaultSize": {
      "height": 200,
      "width": 1012
    }
  },
  "root": {
    "children": [
      {
        "children": [
          {
            "meta": {
              "name": "Title"
            },
            "position": {
              "shrink": 0
            },
            "props": {
              "style": {
                "color": "#5F696B",
                "fontSize": "11px",
                "fontWeight": 700,
                "letterSpacing": "0.1em",
                "lineHeight": "20px",
                "whiteSpace": "nowrap"
              },
              "text": "ALARMS"
            },
            "type": "ia.display.label"
          },
          {
            "meta": {
              "name": "Badge"
            },
            "position": {
              "shrink": 0
            },
            "propConfig": {
              "position.display": {
                "binding": {
                  "config": {
                    "expression": "coalesce(try({view.custom.count} \u003e\u003d 0, false), false)"
                  },
                  "type": "expr"
                }
              },
              "props.style.backgroundColor": {
                "binding": {
                  "config": {
                    "expression": "if({view.custom.count} \u003e 0, \u0027#C02026\u0027, \u0027#EEF1F1\u0027)"
                  },
                  "type": "expr"
                }
              },
              "props.style.color": {
                "binding": {
                  "config": {
                    "expression": "if({view.custom.count} \u003e 0, \u0027#FFFFFF\u0027, \u0027#4A5558\u0027)"
                  },
                  "type": "expr"
                }
              },
              "props.text": {
                "binding": {
                  "config": {
                    "expression": "toStr({view.custom.count}) + \u0027 active\u0027"
                  },
                  "type": "expr"
                }
              }
            },
            "props": {
              "style": {
                "borderRadius": "10px",
                "fontSize": "11px",
                "fontWeight": 700,
                "lineHeight": "18px",
                "padding": "0px 8px",
                "whiteSpace": "nowrap"
              },
              "text": ""
            },
            "type": "ia.display.label"
          },
          {
            "children": [],
            "meta": {
              "name": "Spacer"
            },
            "position": {
              "basis": "0px",
              "grow": 1,
              "shrink": 1
            },
            "props": {
              "direction": "row"
            },
            "type": "ia.container.flex"
          },
          {
            "meta": {
              "name": "All"
            },
            "position": {
              "shrink": 0
            },
            "props": {
              "style": {
                "color": "#4A5558",
                "fontSize": "11.5px",
                "fontWeight": 600,
                "lineHeight": "20px",
                "whiteSpace": "nowrap"
              },
              "text": "All alarms + 30-day history"
            },
            "type": "ia.display.label"
          },
          {
            "meta": {
              "name": "AllIcon"
            },
            "position": {
              "basis": "14px",
              "shrink": 0
            },
            "props": {
              "color": "#4A5558",
              "path": "material/open_in_full",
              "style": {
                "height": "14px",
                "width": "14px"
              }
            },
            "type": "ia.display.icon"
          }
        ],
        "meta": {
          "name": "Header"
        },
        "position": {
          "basis": "20px",
          "shrink": 0
        },
        "props": {
          "alignItems": "center",
          "direction": "row",
          "style": {
            "gap": "8px",
            "overflow": "hidden"
          }
        },
        "type": "ia.container.flex"
      },
      {
        "meta": {
          "name": "AlarmStatusTable"
        },
        "position": {
          "basis": "0px",
          "grow": 1,
          "shrink": 1
        },
        "propConfig": {
          "props.filters.active.conditions.displayPath": {
            "binding": {
              "config": {
                "path": "view.params.filter"
              },
              "type": "property"
            }
          }
        },
        "props": {
          "activeSortOrder": [
            "activeTime"
          ],
          "columns": {
            "active": {
              "activeTime": {
                "order": 0,
                "sort": "descending",
                "strictWidth": true,
                "width": 170
              },
              "displayPath": {
                "enabled": false,
                "order": 3,
                "width": 150
              },
              "label": {
                "enabled": true,
                "order": 1,
                "width": 120
              },
              "name": {
                "enabled": false,
                "order": 5,
                "width": 150
              },
              "priority": {
                "enabled": false,
                "sort": "none"
              },
              "source": {
                "enabled": false,
                "order": 4,
                "width": 250
              },
              "state": {
                "enabled": false
              }
            }
          },
          "dateFormat": "DD/MM HH:mm:ss",
          "dragOrderable": false,
          "enableShelve": false,
          "filters": {
            "active": {
              "conditions": {
                "displayPath": ""
              },
              "states": {
                "clearUnacked": false
              }
            }
          },
          "pager": {
            "hide": true,
            "initialOption": 250,
            "options": [
              10,
              25,
              50,
              100,
              250
            ]
          },
          "refreshRate": 1000,
          "rowStyles": {
            "activeAcked": {
              "base": {
                "backgroundColor": "#FDF4F4",
                "color": "#6E1C1F",
                "fontSize": "15px"
              },
              "priorities": {
                "critical": {
                  "backgroundColor": "#FDF4F4",
                  "color": "#6E1C1F"
                },
                "diagnostic": {
                  "backgroundColor": "#F6F7F7",
                  "color": "#4A5558"
                },
                "high": {
                  "backgroundColor": "#FDF4F4",
                  "color": "#6E1C1F"
                },
                "low": {
                  "backgroundColor": "#FFFAE6",
                  "color": "#5C4A00"
                },
                "medium": {
                  "backgroundColor": "#FEF3EA",
                  "color": "#7A3A0A"
                }
              }
            },
            "activeUnacked": {
              "base": {
                "backgroundColor": "#F6D5D6",
                "color": "#8E1A1E",
                "fontSize": "15px",
                "fontWeight": 600
              },
              "priorities": {
                "critical": {
                  "backgroundColor": "#F6D5D6",
                  "color": "#8E1A1E"
                },
                "diagnostic": {
                  "backgroundColor": "#EEF1F1",
                  "color": "#4A5558"
                },
                "high": {
                  "backgroundColor": "#F6D5D6",
                  "color": "#8E1A1E"
                },
                "low": {
                  "backgroundColor": "#FFF3C4",
                  "color": "#5C4A00"
                },
                "medium": {
                  "backgroundColor": "#FCE3CF",
                  "color": "#7A3A0A"
                }
              }
            },
            "clearAcked": {
              "base": {
                "backgroundColor": "#FFFFFF",
                "color": "#4A5558",
                "fontSize": "15px"
              },
              "priorities": {
                "critical": {
                  "backgroundColor": "#FFFFFF",
                  "color": "#4A5558"
                },
                "diagnostic": {
                  "backgroundColor": "#FFFFFF",
                  "color": "#4A5558"
                },
                "high": {
                  "backgroundColor": "#FFFFFF",
                  "color": "#4A5558"
                },
                "low": {
                  "backgroundColor": "#FFFFFF",
                  "color": "#4A5558"
                },
                "medium": {
                  "backgroundColor": "#FFFFFF",
                  "color": "#4A5558"
                }
              }
            },
            "clearUnacked": {
              "base": {
                "backgroundColor": "#FFFFFF",
                "color": "#4A5558",
                "fontSize": "15px"
              },
              "priorities": {
                "critical": {
                  "backgroundColor": "#FFFFFF",
                  "color": "#4A5558"
                },
                "diagnostic": {
                  "backgroundColor": "#FFFFFF",
                  "color": "#4A5558"
                },
                "high": {
                  "backgroundColor": "#FFFFFF",
                  "color": "#4A5558"
                },
                "low": {
                  "backgroundColor": "#FFFFFF",
                  "color": "#4A5558"
                },
                "medium": {
                  "backgroundColor": "#FFFFFF",
                  "color": "#4A5558"
                }
              }
            }
          },
          "selection": {
            "active": {
              "mode": "none"
            },
            "shelved": {
              "mode": "none"
            }
          },
          "shelvingTimes": [
            0,
            900,
            1800,
            3600,
            7200,
            14400
          ],
          "style": {
            "borderStyle": "none",
            "fontSize": "15px"
          },
          "toolbar": {
            "enablePreFilters": false,
            "enableShelvedTab": false,
            "enabled": false
          }
        },
        "type": "ia.display.alarmstatustable"
      }
    ],
    "events": {
      "dom": {
        "onClick": {
          "config": {
            "script": "\tbooth.ui.openAlarms(self.view.params.filter, self.view.params.title)"
          },
          "scope": "G",
          "type": "script"
        }
      }
    },
    "meta": {
      "name": "root",
      "tooltip": {
        "enabled": true,
        "text": "Tap for all the alarms and the 30-day history - tap outside to close"
      }
    },
    "props": {
      "direction": "column",
      "style": {
        "backgroundColor": "#FFFFFF",
        "border": "1px solid #DDE1E1",
        "borderRadius": "8px",
        "boxSizing": "border-box",
        "cursor": "pointer",
        "gap": "6px",
        "overflow": "hidden",
        "padding": "12px 16px"
      }
    },
    "type": "ia.container.flex"
  }
}